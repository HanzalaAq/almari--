{
  "expo": {
    "name": "Almari",
    "slug": "almari",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.almari.app"
    },
    "android": {
      "package": "com.almari.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar"
    ],
    "scheme": "almari",
    "experiments": {
      "typedRoutes": true
    }
  }
}
